#usda 1.0
(
    defaultPrim = "g1_29dof_rev_1_0"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @../robots/unitree_g1_usd/g1_29dof_rev_1_0.usd@
    ]
    doc = "G1 scene: the unmodified Unitree G1 layer plus a ground collider. See README.md in this directory."
)

def Plane "ground" (
    apiSchemas = ["PhysicsCollisionAPI"]
)
{
    uniform token axis = "Z"
    double width = 20
    double length = 20
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    float physics:dynamicFriction = 0.8
    double sim:contactStiffness = 20000
    double sim:contactDamping = 200
    uniform token[] sim:tags = ["environment", "collider"]
}
