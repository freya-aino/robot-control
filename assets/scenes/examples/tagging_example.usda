#usda 1.0
(
    defaultPrim = "scene"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Example of the universal scene tags: sim:tags = [\"environment\", \"collider\"] makes a prim a static collider, wherever it is in any scene."
)

def Xform "scene"
{
    def Plane "tagged_plane" (
        apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double3 xformOp:translate = (0, 0, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token[] sim:tags = ["environment", "collider"]
        float physics:dynamicFriction = 0.6
        double sim:contactStiffness = 20000
        double sim:contactDamping = 200
    }

    def Cube "tagged_box" (
        apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 0.5
        double3 xformOp:translate = (1, 0, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token[] sim:tags = ["environment", "collider"]
    }

    def Cube "visual_block"
    {
        double size = 0.5
        double3 xformOp:translate = (-1, 0, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token[] sim:tags = ["environment"]
    }

    def Cube "unrelated_prop"
    {
        double size = 0.5
        double3 xformOp:translate = (0, 1, 0.25)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        uniform token[] sim:tags = ["furniture"]
    }
}
