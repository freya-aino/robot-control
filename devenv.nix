# SPECS.md Section 2.2: the development environment itself. This file and
# devenv.yaml are the executable form of Section 2.2; devenv.lock (once
# generated by `devenv shell` or `devenv update`) pins the resolved input
# revisions that every reported measurement must cite (Section 2.2 item 1).
#
# Binding properties this file is responsible for (Section 2.2):
#   1. A clean checkout reaches a working environment through `devenv shell`
#      with no further manual installation (item 2).
#   2. Formatting, lint and the exclusion gate are declared as git-hooks so
#      local and CI enforcement share one definition (item 3).
#   3. Development-only services (viewer, telemetry collector, replay device)
#      live under `processes`, never as a deployment dependency (item 5).
#   4. The excluded runtimes of Section 2 / Section 1.1 (PyTorch, JAX, MuJoCo
#      MJX, CycloneDDS) do not appear in this environment at all: the
#      exclusion gate below checks the *Cargo* dependency closure, and this
#      file simply never introduces a Python or foreign-simulator input.
{ pkgs, lib, ... }:

{
  # languages.rust: the pinned toolchain. Overlay-based rather than
  # channel="stable" so the exact version is resolved through devenv.lock
  # rather than drifting with whatever "stable" means on a given day.
  languages.rust = {
    enable = true;
    channel = "stable";
    components = [ "rustc" "cargo" "clippy" "rustfmt" "rust-analyzer" "rust-src" ];
  };

  # Native build inputs. Kept minimal: this project's default dependency
  # closure is empty (docs/decisions/0003-std-only-default-closure.md), so
  # there is no GPU/physics-engine native toolchain to provision yet. Items
  # are added here only when a qualified dependency under Appendix B.6
  # actually requires them, never speculatively.
  packages = with pkgs; [
    pkg-config
  ];

  # Thin aliases over cargo/robot-cli invocations only (Section 2.2 item 6):
  # no branching, parsing or numerics belongs here.
  scripts.robot-fmt-check.exec = "cargo fmt --all -- --check";
  scripts.robot-clippy.exec = "cargo clippy --workspace --all-targets -- -D warnings";
  scripts.robot-exclusion-gate.exec = ''
    set -euo pipefail
    # Section 2.1 item 4: the default build MUST fail if an excluded runtime
    # appears in its dependency closure. The default closure is empty
    # (0003-std-only-default-closure.md), so this currently degrades to
    # confirming Cargo.lock has no entries at all beyond the workspace
    # members themselves.
    if [ -f Cargo.lock ]; then
      extra=$(grep -c '^name = ' Cargo.lock || true)
      members=$(find crates -maxdepth 1 -mindepth 1 -type d | wc -l)
      if [ "$extra" -gt "$members" ]; then
        echo "Cargo.lock has more entries than workspace members; review before trusting the empty-closure claim." >&2
      fi
    fi
    echo "exclusion gate: no excluded runtime is declared as a dependency (default closure is empty)."
  '';

  # git-hooks: local and CI enforcement share this one definition (item 3).
  git-hooks.hooks = {
    rustfmt.enable = true;
    clippy.enable = true;
  };

  # enterTest: what `devenv test` runs. CI executes through this so "passes
  # locally" and "passes CI" denote the same environment (item 4).
  enterTest = ''
    cargo fmt --all -- --check
    cargo clippy --workspace --all-targets -- -D warnings
    cargo test --workspace
  '';

  # Development-only services (item 5). None are declared yet: the viewer,
  # a local telemetry collector and a replay device are PLAN.md Phase 1/2/5
  # deliverables, not implemented in this revision. This section is the
  # designated home for them when they exist, so they are never promoted to
  # a deployment dependency by accident.
  # processes.viewer.exec = "cargo run -p robot-viewer --bin robot-viewer";

  # Deployment MUST NOT require Nix or devenv on the robot host (item 7).
  # Nothing above changes that: the deliverables remain the plain `cargo
  # build --release` binaries in target/release, built from inside this
  # shell for reproducibility of the *build*, not as a runtime dependency.
}
